    // }

    $db->commit();

    echo json_encode([
        "success" => true,
        "message" => "Payment applied successfully"
    ]);

} catch (Exception $e) {

    if ($db->inTransaction()) {
        $db->rollBack();
    }

    echo json_encode([
        "success" => false,
        "error" => $e->getMessage()
    ]);
}