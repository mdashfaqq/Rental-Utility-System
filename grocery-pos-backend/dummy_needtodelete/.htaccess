# # ---  TOP  OF  .htaccess  ---
# <IfModule mod_headers.c>
#     Header always set Access-Control-Allow-Origin "http://localhost:8080"
#     Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
#     Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
#     Header always set Access-Control-Allow-Credentials "true"
# </IfModule>

RewriteEngine On

# Handle CORS preflight requests
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^(.*)$ $1 [R=200,L]

# API Routes
RewriteRule ^api/products/?$ api/products.php [QSA,L]
RewriteRule ^api/categories/?$ api/categories.php [QSA,L]
RewriteRule ^api/vendors/?$ api/vendors.php [QSA,L]
RewriteRule ^api/transactions/?$ api/transactions.php [QSA,L]
RewriteRule ^api/dashboard/?$ api/dashboard.php [QSA,L]

# Disable directory browsing
Options -Indexes

# Secure sensitive files
<Files "*.sql">
    Order allow,deny
    Deny from all
</Files>

<Files "config/*">
    Order allow,deny
    Deny from all
</Files>
